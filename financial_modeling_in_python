"""Mathematical modeling concepts for the XRP trading strategy.

The functions deliberately mirror the equations in README.md.
Run this file directly to see the examples.
"""

from dataclasses import dataclass
from math import prod
from random import Random
from statistics import mean, stdev
from typing import Callable, Iterable


# ---------------------------------------------------------------------------
# 1. STATE / DRAWdown
# ---------------------------------------------------------------------------

def drawdown(price: float, reference_high: float) -> float:
    """D_t = 1 - P_t / H*_t"""
    if reference_high <= 0:
        raise ValueError("reference_high must be positive")
    return 1.0 - price / reference_high


def entry_signal(price: float, reference_high: float, entry_threshold: float) -> bool:
    """Boolean form of D_t >= e."""
    return drawdown(price, reference_high) >= entry_threshold


def indicator(condition: bool) -> int:
    """Indicator function: 1 if true, 0 otherwise."""
    return int(condition)


# ---------------------------------------------------------------------------
# 2. EXIT RULES
# ---------------------------------------------------------------------------

def target_price(entry_price: float, target: float) -> float:
    """P_target = P_entry * (1 + t)"""
    return entry_price * (1.0 + target)


def stop_price(entry_price: float, stop: float) -> float:
    """P_stop = P_entry * (1 - s)"""
    return entry_price * (1.0 - stop)


def trade_return(target: float, stop: float, target_hit_first: bool) -> float:
    """Piecewise R_i: +t if target first, -s if stop first."""
    return target if target_hit_first else -stop


# ---------------------------------------------------------------------------
# 3. PROBABILITY / EXPECTED VALUE
# ---------------------------------------------------------------------------

def expected_return(win_probability: float, target: float, stop: float) -> float:
    """E[R] = p*t - (1-p)*s."""
    p = win_probability
    if not 0 <= p <= 1:
        raise ValueError("win_probability must be between 0 and 1")
    return p * target - (1.0 - p) * stop


def breakeven_win_rate(target: float, stop: float) -> float:
    """p* = s / (t + s)."""
    if target + stop <= 0:
        raise ValueError("target + stop must be positive")
    return stop / (target + stop)


# ---------------------------------------------------------------------------
# 4. COMPOUNDING / PRODUCT OPERATOR
# ---------------------------------------------------------------------------

def compound_wealth(starting_wealth: float, returns: Iterable[float]) -> float:
    """W_n = W_0 * product(1 + R_i)."""
    return starting_wealth * prod(1.0 + r for r in returns)


def wealth_path(starting_wealth: float, returns: Iterable[float]) -> list[float]:
    """Return [W_0, W_1, ..., W_n]."""
    wealth = starting_wealth
    path = [wealth]
    for r in returns:
        wealth *= 1.0 + r
        path.append(wealth)
    return path


# ---------------------------------------------------------------------------
# 5. RISK METRICS
# ---------------------------------------------------------------------------

def max_drawdown(wealth_path_values: Iterable[float]) -> float:
    """MDD = max_t (1 - W_t / running_peak_t)."""
    values = list(wealth_path_values)
    if not values:
        return 0.0

    peak = values[0]
    worst = 0.0
    for wealth in values:
        peak = max(peak, wealth)
        dd = 1.0 - wealth / peak
        worst = max(worst, dd)
    return worst


def profit_factor(returns: Iterable[float]) -> float:
    """Gross profit / gross loss."""
    values = list(returns)
    gross_profit = sum(r for r in values if r > 0)
    gross_loss = -sum(r for r in values if r < 0)
    return float("inf") if gross_loss == 0 else gross_profit / gross_loss


def mean_return(returns: Iterable[float]) -> float:
    values = list(returns)
    return mean(values) if values else 0.0


def return_std(returns: Iterable[float]) -> float:
    values = list(returns)
    return stdev(values) if len(values) > 1 else 0.0


def risk_adjusted_score(returns: Iterable[float]) -> float:
    """Simple E[R] / sigma(R) objective."""
    values = list(returns)
    sigma = return_std(values)
    return 0.0 if sigma == 0 else mean_return(values) / sigma


# ---------------------------------------------------------------------------
# 6. PARAMETER VECTOR θ
# ---------------------------------------------------------------------------

@dataclass(frozen=True)
class StrategyParams:
    """One strategy configuration θ."""

    entry: float
    target: float
    stop: float
    allocation: float = 1.0


# ---------------------------------------------------------------------------
# 7. SIMPLE OBJECTIVE FUNCTION
# ---------------------------------------------------------------------------


def toy_objective(params: StrategyParams, win_probability: float = 0.30) -> float:
    """A toy objective: expected return for a given θ.

    A real backtest would replace this with f(θ, X).
    """
    return expected_return(win_probability, params.target, params.stop)


# ---------------------------------------------------------------------------
# 8. ARGMAX / GRID SEARCH
# ---------------------------------------------------------------------------


def grid_search(
    entries: Iterable[float],
    targets: Iterable[float],
    stops: Iterable[float],
    objective: Callable[[StrategyParams], float],
):
    """Search a finite parameter space and return argmax.

    Mathematically this approximates:
        θ* = argmax_{θ in Θ} J(θ)
    """
    best_params = None
    best_score = float("-inf")
    results = []

    for entry in entries:
        for target in targets:
            for stop in stops:
                params = StrategyParams(entry=entry, target=target, stop=stop)
                score = objective(params)
                results.append((params, score))

                if score > best_score:
                    best_score = score
                    best_params = params

    return best_params, best_score, results


# ---------------------------------------------------------------------------
# 9. MONTE CARLO / STOCHASTIC MODELING
# ---------------------------------------------------------------------------


def monte_carlo_final_wealth(
    historical_returns: list[float],
    starting_wealth: float,
    n_trades: int,
    n_simulations: int,
    seed: int = 42,
) -> list[float]:
    """Bootstrap historical trade returns to create simulated outcomes."""
    if not historical_returns:
        raise ValueError("historical_returns cannot be empty")

    rng = Random(seed)
    finals = []

    for _ in range(n_simulations):
        wealth = starting_wealth
        for _ in range(n_trades):
            r = rng.choice(historical_returns)
            wealth *= 1.0 + r
        finals.append(wealth)

    return finals


# ---------------------------------------------------------------------------
# 10. TRAIN / TEST CONCEPT
# ---------------------------------------------------------------------------


def chronological_split(values: list, split_index: int):
    """X = X_train ∪ X_test, preserving chronological order."""
    return values[:split_index], values[split_index:]



if __name__ == "__main__":
    # Drawdown / state
    print("Drawdown:", drawdown(1.70, 2.00))
    print("Entry signal:", entry_signal(1.70, 2.00, 0.15))
    print("Indicator:", indicator(entry_signal(1.70, 2.00, 0.15)))

    # Exit
    print("Target price:", target_price(1.50, 0.08))
    print("Stop price:", stop_price(1.50, 0.02))

    # Probability
    print("Expected return:", expected_return(0.30, 0.08, 0.02))
    print("Break-even win rate:", breakeven_win_rate(0.08, 0.02))

    # Product / compounding
    returns = [0.08, -0.02, 0.08]
    path = wealth_path(5000.0, returns)
    print("Wealth path:", path)
    print("Ending wealth:", compound_wealth(5000.0, returns))
    print("Max drawdown:", max_drawdown(path))
    print("Profit factor:", profit_factor(returns))

    # Theta / grid search
    best, score, _ = grid_search(
        entries=[0.10, 0.15, 0.20],
        targets=[0.03, 0.05, 0.08],
        stops=[0.01, 0.02, 0.03],
        objective=lambda p: toy_objective(p, win_probability=0.30),
    )
    print("Best θ in toy search:", best)
    print("Best J(θ):", score)

    # Monte Carlo
    mc = monte_carlo_final_wealth(
        historical_returns=returns,
        starting_wealth=5000.0,
        n_trades=50,
        n_simulations=1000,
    )
    print("Monte Carlo mean final wealth:", mean(mc))
    print("Monte Carlo min/max:", min(mc), max(mc))
